button.Size = UDim2.new(0, 150, 0, 44)
button.Position = UDim2.new(1, -185, 0, 80)
button.BackgroundColor3 = Color3.fromRGB(46, 137, 55)
button.BackgroundTransparency = 0.15
button.BorderSizePixel = 0
button.Font = Enum.Font.GothamBold
button.Text = "Auto Stock"
button.TextColor3 = Color3.new(1, 1, 1)
button.TextSize = 15
button.AutoButtonColor = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = button

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Transparency = 0.7
stroke.Thickness = 1.5
stroke.Parent = button

local isRunning = false

button.MouseButton1Click:Connect(function()
	if isRunning then return end
	isRunning = true
	button.Text = "Stocking..."
	button.BackgroundColor3 = Color3.fromRGB(200, 150, 30)
	button.AutoButtonColor = false

	task.spawn(function()
		local count, message = autoStockShelves()

		button.Text = message
		if count > 0 then
			button.BackgroundColor3 = Color3.fromRGB(30, 120, 200)
		else
			button.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
		end

		task.wait(2.5)

		button.Text = "Auto Stock"
		button.BackgroundColor3 = Color3.fromRGB(46, 137, 55)
		button.AutoButtonColor = true
		isRunning = false
	end)
end)
