local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local VehiclesFolder = ReplicatedStorage:WaitForChild("Events"):WaitForChild("Vehicles")
local GetVehicleItems = VehiclesFolder:WaitForChild("GetVehicleItems")
local TransferVehicleItemsToInventory = VehiclesFolder:WaitForChild("TransferVehicleItemsToInventory")
local PlotFolder = ReplicatedStorage:WaitForChild("Events"):WaitForChild("Plot")
local RequestPlotData = PlotFolder:WaitForChild("RequestPlotData")
local ItemGridPanel

local moduleScript = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Utils"):WaitForChild("ItemGridPanel")
local ok, loadmodule = pcall(function() return debug.loadmodule end)
if ok and loadmodule then
    local success, moduleFunc = pcall(loadmodule, moduleScript)
    if success and type(moduleFunc) == "function" then
        ItemGridPanel = moduleFunc()
    end
end
if not ItemGridPanel then
    local okModule, res = pcall(function()
        return getrenv().require(moduleScript)
    end)
    if okModule then
        ItemGridPanel = res
    else
        ItemGridPanel = {}
        warn("Could not securely bind ItemGridPanel. Base prices will default.")
    end
end

local function getPlotData()
	local ok, result = pcall(function()
		return RequestPlotData:InvokeServer()
	end)
	if ok and result then
		return result
	end
	return nil
end

local function getUnpackZoneCFrame(plotData)
	if not plotData then return nil end
	local rotY = math.rad(plotData.RotationY or 0)
	local originCFrame = CFrame.new(plotData.OriginX, plotData.OriginY, plotData.OriginZ) * CFrame.Angles(0, rotY, 0)
	local zonePosition = originCFrame:PointToWorldSpace(Vector3.new(0, 0, -100))
	return CFrame.new(zonePosition) * CFrame.Angles(0, rotY, 0)
end

local function findMyVehicle()
	local vehicleGUID = LocalPlayer:GetAttribute("EquippedVehicle")
	if not vehicleGUID or vehicleGUID == "" then
		return nil
	end
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("Model")
			and desc:GetAttribute("VehicleGUID") == vehicleGUID
			and desc:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
			return desc
		end
	end
	return nil
end

local function isSeatedInOwnVehicle()
	local character = LocalPlayer.Character
	if not character then return false end
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return false end
	local seatPart = humanoid.SeatPart
	if not seatPart or not seatPart:IsA("VehicleSeat") then return false end
	local vehicleModel = seatPart:FindFirstAncestorOfClass("Model")
	if not vehicleModel then return false end
	return vehicleModel:GetAttribute("VehicleGUID") == LocalPlayer:GetAttribute("EquippedVehicle")
end

local function computeEntryPrice(entry)
	if ItemGridPanel.ComputeEntryPrice then
		local ok, price = pcall(function()
			return ItemGridPanel.ComputeEntryPrice(entry)
		end)
		if ok and type(price) == "number" then
			return price
		end
	end
	return entry.BasePrice or 0
end
local function autoSeatInVehicle(vehicle)
	local character = LocalPlayer.Character
	if not character then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not hrp then return false end

	local targetSeat = nil
	for _, desc in ipairs(vehicle:GetDescendants()) do
		if (desc:IsA("VehicleSeat") or desc:IsA("Seat")) and desc.Occupant == nil then
			targetSeat = desc
			break
		end
	end

	if not targetSeat then
		warn("[AutoUnload] No open seat found inside vehicle model.")
		return false
	end

	hrp.CFrame = targetSeat.CFrame * CFrame.new(0, 1.5, 0)
	task.wait(0.1)

	pcall(function()
		targetSeat:Sit(humanoid)
	end)
	local timeout = 2.0
	local startTime = os.clock()
	while os.clock() - startTime < timeout do
		if humanoid.SeatPart == targetSeat then
			return true
		end
		if os.clock() - startTime > 0.6 and humanoid.SeatPart ~= targetSeat then
			pcall(function()
				targetSeat:Sit(humanoid)
			end)
			task.wait(0.2)
		end
		task.wait(0.05)
	end

	return humanoid.SeatPart == targetSeat
end

local function autoUnloadVehicle()
	local vehicleGUID = LocalPlayer:GetAttribute("EquippedVehicle")
	if not vehicleGUID or vehicleGUID == "" then
		return 0, "No equipped vehicle!"
	end
	local plotData = getPlotData()
	if not plotData then
		return 0, "No plot data!"
	end

	local zoneCFrame = getUnpackZoneCFrame(plotData)
	if not zoneCFrame then
		return 0, "Can't find unload zone!"
	end
	
	local vehicle = findMyVehicle()
	if not vehicle then
		return 0, "Vehicle not in workspace!"
	end

	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return 0, "Character missing!" end
	local wasSeated = isSeatedInOwnVehicle()
	if not wasSeated then
		local targetCFrame = zoneCFrame + Vector3.new(0, 3, 0)
		hrp.CFrame = targetCFrame
		task.wait(0.4)

		vehicle:PivotTo(targetCFrame)
		task.wait(0.4)
		local seated = autoSeatInVehicle(vehicle)
		if not seated then
			return 0, "Could not enter vehicle!"
		end
		task.wait(0.3)
	else
		local targetCFrame = zoneCFrame + Vector3.new(0, 3, 0)
		vehicle:PivotTo(targetCFrame)
		task.wait(1.5)
	end
	local ok, items = pcall(function()
		return GetVehicleItems:InvokeServer(vehicleGUID)
	end)
	if not ok or type(items) ~= "table" then
		return 0, "Could not get vehicle items!"
	end
	local allItems = {}
	for guid, entry in pairs(items) do
		table.insert(allItems, {
			guid = guid,
			entry = entry,
			price = computeEntryPrice(entry),
		})
	end

	if #allItems == 0 then
		return 0, "Vehicle is empty!"
	end
	table.sort(allItems, function(a, b)
		if a.price ~= b.price then
			return a.price > b.price
		end
		local nameA = tostring(a.entry and a.entry.Name or (a.entry and a.entry.ItemId or a.guid))
		local nameB = tostring(b.entry and b.entry.Name or (b.entry and b.entry.ItemId or a.guid))
		return nameA < nameB
	end)
	local inventoryCap = LocalPlayer:GetAttribute("InventoryCap") or 0
	local inventoryCount = LocalPlayer:GetAttribute("InventoryCount") or 0
	local freeSlots = math.max(0, inventoryCap - inventoryCount)

	local selectedGuids = {}
	for i, item in ipairs(allItems) do
		if #selectedGuids >= freeSlots then break end
		table.insert(selectedGuids, item.guid)
	end

	if #selectedGuids == 0 then
		return 0, "No inventory space!"
	end
	local success, err = pcall(function()
		TransferVehicleItemsToInventory:FireServer(selectedGuids)
	end)

	if not success then
		return 0, "Unload failed!"
	end

	local unloaded = #selectedGuids
	local remaining = #allItems - #selectedGuids
	if remaining > 0 then
		return unloaded, "Unloaded " .. unloaded .. " (" .. remaining .. " left - no space)"
	else
		return unloaded, "Unloaded " .. unloaded .. " item" .. (unloaded ~= 1 and "s" or "") .. "!"
	end
end

