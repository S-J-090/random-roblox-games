	button.AutoButtonColor = false

	task.spawn(function()
		local count, message = autoUnloadVehicle()

		button.Text = message
		if count > 0 then
			button.BackgroundColor3 = Color3.fromRGB(30, 120, 200)
		else
			button.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
		end

		task.wait(2.5)

		button.Text = "Auto Unload"
		button.BackgroundColor3 = Color3.fromRGB(46, 100, 180)
		button.AutoButtonColor = true
		isRunning = false
	end)
end)
