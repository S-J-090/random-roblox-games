end
local function saveConfig()
    local data = {}
    for name, box in pairs(boxes) do
        data[name] = {
            XScale = box.Position.X.Scale, XOffset = box.Position.X.Offset,
            YScale = box.Position.Y.Scale, YOffset = box.Position.Y.Offset
        }
    end
    if writefile then
        writefile(configFileName, HttpService:JSONEncode(data))
        saveBtn.Text = "Saved!"
        task.wait(1)
        saveBtn.Text = "Save Box Positions"
    end
end
local function loadConfig()
    if isfile and isfile(configFileName) and readfile then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(configFileName))
        end)
        if success and type(decoded) == "table" then
            for name, pos in pairs(decoded) do
                if boxes[name] then
                    boxes[name].Position = UDim2.new(pos.XScale, pos.XOffset, pos.YScale, pos.YOffset)
                end
            end
        end
    end
end
