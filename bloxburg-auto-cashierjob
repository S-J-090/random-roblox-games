local function extractID(imageString)
    if type(imageString) ~= "string" then return nil end
    local bestMatch = ""
    for match in string.gmatch(imageString, "%d+") do
        if string.len(match) > string.len(bestMatch) then
            bestMatch = match
        end
    end
    return bestMatch ~= "" and bestMatch or nil
end
local function clickBox(box)
    if not box or not autoFarming then return end
    local guiInset = GuiService:GetGuiInset()
    local targetX = box.AbsolutePosition.X + (box.AbsoluteSize.X / 2)
    local targetY = box.AbsolutePosition.Y + (box.AbsoluteSize.Y / 2) + guiInset.Y
    VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
    task.wait(0.5)
end
local function executeOrderQueue()
	task.wait(0.2)
    clickBox(boxes["Bottom Bun"])
    for _, item in ipairs(currentOrder.frame1) do
        clickBox(boxes[item])
    end
    clickBox(boxes["Top Bun"])
    clickBox(boxes["Tab 2"])
    while #currentOrder.frame2 == 0 do
        if not autoFarming or not currentCustomer or not currentCustomer.Parent then return end
        task.wait(0.1)
    end
    for _, info in ipairs(currentOrder.frame2) do
        clickBox(boxes[info.item])
        if info.size then 
            clickBox(boxes["Size " .. info.size]) 
        end
    end
    clickBox(boxes["Tab 3"])
    local waitTimer = 0
    while #currentOrder.frame3 == 0 and waitTimer < 2 do
        if not autoFarming or not currentCustomer or not currentCustomer.Parent then return end
        task.wait(0.1)
        waitTimer += 0.1
    end
    if #currentOrder.frame3 > 0 then
        for _, info in ipairs(currentOrder.frame3) do
            clickBox(boxes[info.item])
            if info.size then 
                clickBox(boxes["Size " .. info.size]) 
            end
        end
    end
    clickBox(boxes["Finished"])
end
local function resetState(newCustomer)
    currentCustomer = newCustomer
    currentOrder = { frame1 = {}, frame2 = {}, frame3 = {} }
    readIcons = {}
    lastUpdateTime = tick()
    isProcessingOrder = false
    hasFinishedOrder = false
end
resetState(nil) 
RunService.RenderStepped:Connect(function()
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    if currentCustomer then
        if not currentCustomer.Parent then
            resetState(nil)
        else
            local head = currentCustomer:FindFirstChild("Head")
            if not head or (head.Position - rootPart.Position).Magnitude > 20 then
                resetState(nil)
            end
        end
    end
    if not currentCustomer then
        local spawnedChars = workspace:FindFirstChild("_game") and workspace._game:FindFirstChild("SpawnedCharacters")
        if spawnedChars then
            local nearest, minDistance = nil, 20 
            for _, char in ipairs(spawnedChars:GetChildren()) do
                if char.Name == "BloxBurgersCustomer" then
                    local head = char:FindFirstChild("Head")
                    if head and head:FindFirstChild("ChatBubble") then
                        local dist = (head.Position - rootPart.Position).Magnitude
                        if dist < minDistance then
                            minDistance = dist
                            nearest = char
                        end
                    end
                end
            end
            if nearest then resetState(nearest) end
        end
    end
    if not currentCustomer or not autoFarming then return end
    local head = currentCustomer:FindFirstChild("Head")
    local chatBubble = head and head:FindFirstChild("ChatBubble")
    local body = chatBubble and chatBubble:FindFirstChild("Body")
    local iconFrame = body and body:FindFirstChild("IconFrame")
    if iconFrame then
        local orderUpdated = false
        for i = 1, 3 do
            local frameStr = tostring(i)
            local frame = iconFrame:FindFirstChild(frameStr)
            if frame then
                for _, child in ipairs(frame:GetChildren()) do
                    if child:IsA("ImageLabel") and child.Name == "Icon" and not readIcons[child] then
                        local parsedID = extractID(child.Image)
                        if parsedID then
                            local mappedBox = mapToBox[parsedID]
                            if mappedBox then
                                if i == 1 then
                                    local count = 1
                                    local amountImg = child:FindFirstChild("Amount")
                                    if amountImg and amountImg:FindFirstChild("TextLabel") then
                                        local amtMatch = string.match(amountImg.TextLabel.Text, "%d+")
                                        if amtMatch then count = tonumber(amtMatch) end
                                    end
                                    for _ = 1, count do
                                        table.insert(currentOrder.frame1, mappedBox)
                                    end
                                else
                                    local sizeChar = nil
                                    local sizeImg = child:FindFirstChild("Size")
                                    if sizeImg and sizeImg:FindFirstChild("TextLabel") then
                                        local txt = sizeImg.TextLabel.Text
                                        if string.find(txt, "S") then sizeChar = "S"
                                        elseif string.find(txt, "M") then sizeChar = "M"
                                        elseif string.find(txt, "L") then sizeChar = "L"
                                        end
                                    end
                                    table.insert(currentOrder["frame" .. frameStr], {
                                        item = mappedBox,
                                        size = sizeChar
                                    })
                                end
                                readIcons[child] = true
                                orderUpdated = true
                            end
                        end
                    end
                end
            end
        end
        if orderUpdated then
            lastUpdateTime = tick()
        end
    end
    if not isProcessingOrder and not hasFinishedOrder then
        if (tick() - lastUpdateTime > 1.0) and #currentOrder.frame1 > 0 then
            isProcessingOrder = true
            task.spawn(function()
                executeOrderQueue()
                hasFinishedOrder = true
                isProcessingOrder = false
            end)
        end
    end
end)
