local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local DEBOUNCE = 0.5
local autoBidOn = false
local lastBidTime = 0
local heartbeatConn = nil
local cachedContainer = nil
local autoPickupOn = false
local pickupLoopRunning = false
local Items
pcall(function()
	Items = require(ReplicatedStorage.Modules.Items)
end)

local gui, panel, bidBtn, pickupBtn, statusLbl

local function findContainer()
	if cachedContainer and cachedContainer.Parent then
		return cachedContainer
	end
	cachedContainer = nil
	for _, sg in PlayerGui:GetChildren() do
		if sg:IsA("ScreenGui") then
			local c = sg:FindFirstChild("AuctionBiddingContainer", true)
			if c then
				cachedContainer = c
				return c
			end
		end
	end
	return nil
end

local bidRemote
local function getBidRemote()
	if bidRemote then return bidRemote end
	local ok, remote = pcall(function()
		return ReplicatedStorage.Events.Auction.Bid
	end)
	if ok and remote then
		bidRemote = remote
	end
	return bidRemote
end

local function isSafe(model)
	if not model or not Items then return false end
	local itemId = model:GetAttribute("ItemId")
	if not itemId then return false end
	local itemDef = Items[tostring(itemId)]
	return itemDef ~= nil and itemDef.SafeId ~= nil
end

local function isOwnedByPlayer(model)
	if not model then return false end
	local owner = model:GetAttribute("Owner")
	return owner == nil or owner == 0 or owner == LocalPlayer.UserId
end
local cachedBoxPrompts = {}
local cachedPickupPrompts = {}
local promptsInitialized = false

local function classifyAndCachePrompt(prompt)
	if prompt.Name == "OpenBoxPrompt" then
		table.insert(cachedBoxPrompts, prompt)
	elseif prompt.Name == "PickupPrompt" then
		table.insert(cachedPickupPrompts, prompt)
	end
end

local function removePromptFromCache(prompt)
	for i = #cachedBoxPrompts, 1, -1 do
		if cachedBoxPrompts[i] == prompt then
			table.remove(cachedBoxPrompts, i)
		end
	end
	for i = #cachedPickupPrompts, 1, -1 do
		if cachedPickupPrompts[i] == prompt then
			table.remove(cachedPickupPrompts, i)
		end
	end
end

local function initPromptCache()
	if promptsInitialized then return end
	promptsInitialized = true
	cachedBoxPrompts = {}
	cachedPickupPrompts = {}
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			classifyAndCachePrompt(d)
		end
	end

	Workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			classifyAndCachePrompt(d)
		end
	end)

	Workspace.DescendantRemoving:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			removePromptFromCache(d)
		end
	end)
end
local function getValidPrompts()
	local boxes = {}
	local pickups = {}

	for _, prompt in ipairs(cachedBoxPrompts) do
		if prompt.Parent then
			local model = prompt:FindFirstAncestorOfClass("Model")
			if isOwnedByPlayer(model) then
				table.insert(boxes, prompt)
			end
		end
	end

	for _, prompt in ipairs(cachedPickupPrompts) do
		if prompt.Parent then
			local model = prompt:FindFirstAncestorOfClass("Model")
			if isOwnedByPlayer(model) and not isSafe(model) then
				table.insert(pickups, prompt)
			end
		end
	end

	return boxes, pickups
end

local function teleportTo(pos)
	local character = LocalPlayer.Character
	if not character then return false end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	character:PivotTo(CFrame.new(pos))
	return true
end

local function triggerPrompt(prompt)
	if not prompt or not prompt.Parent then return false end
	local holdDuration = prompt.HoldDuration or 0
	local ok = pcall(function()
		prompt:InputHoldBegin()
	end)
	if not ok then return false end
	task.wait(holdDuration + 0.05)
	pcall(function()
		prompt:InputHoldEnd()
	end)
	return true
end

local function teleportAndTrigger(prompt)
	if not prompt or not prompt.Parent then return false end
	local model = prompt:FindFirstAncestorOfClass("Model")
	if not model then return false end
	local pos = model:GetPivot().Position
	teleportTo(pos + Vector3.new(0, 3, 0))
	task.wait(0.1)
	return triggerPrompt(prompt)
end

local function runPickupLoop()
	if pickupLoopRunning then return end
	pickupLoopRunning = true

	initPromptCache()

	task.spawn(function()
		while autoPickupOn do
			local character = LocalPlayer.Character
			if not character or not character:FindFirstChild("HumanoidRootPart") then
				task.wait(0.5)
				continue
			end

			local startPos = character:GetPivot()

			local boxPrompts, pickupPrompts = getValidPrompts()

			for _, prompt in ipairs(boxPrompts) do
				if not autoPickupOn then break end
				teleportAndTrigger(prompt)
			end

			if #boxPrompts > 0 then
				task.wait(1.0)
			end

			local _, currentPickups = getValidPrompts()
			for _, prompt in ipairs(currentPickups) do
				if not autoPickupOn then break end
				teleportAndTrigger(prompt)
			end

			if autoPickupOn then
				character = LocalPlayer.Character
				if character then
					character:PivotTo(startPos)
				end
			end

			task.wait(0.3)
		end
		pickupLoopRunning = false
	end)
end

