local function startLoop()
	if heartbeatConn then return end
	heartbeatConn = RunService.RenderStepped:Connect(function()
		if not autoBidOn then
			if statusLbl then
				statusLbl.Text = "Ready"
				statusLbl.TextColor3 = Color3.fromRGB(140, 140, 140)
			end
			return
		end

		local container = findContainer()
		if not container then
			if statusLbl then statusLbl.Text = "No game UI" end
			return
		end

		local now = os.clock()
		if now - lastBidTime < DEBOUNCE then return end

		local bidBarRow = container:FindFirstChild("BidBarRow")
		if not bidBarRow or not bidBarRow.Visible then
			if statusLbl then
				statusLbl.Text = "Waiting..."
				statusLbl.TextColor3 = Color3.fromRGB(100, 200, 255)
			end
			return
		end

		local track = bidBarRow:FindFirstChild("Track")
		if not track then return end
		local cursor = track:FindFirstChild("Cursor")
		local zone = track:FindFirstChild("BidZone")
		if not cursor or not zone then return end

		local trackAbsPos = track.AbsolutePosition.X
		local trackAbsSize = track.AbsoluteSize.X
		local cursorX = (cursor.AbsolutePosition.X - trackAbsPos) / trackAbsSize
		local zoneX = (zone.AbsolutePosition.X - trackAbsPos) / trackAbsSize
		local zoneW = zone.AbsoluteSize.X / trackAbsSize

		local inZone = (zoneX <= cursorX + 0.0075) and (cursorX - 0.0075 <= zoneX + zoneW)
		if not inZone then
			if statusLbl then
				statusLbl.Text = "Tracking..."
				statusLbl.TextColor3 = Color3.fromRGB(200, 200, 100)
			end
			return
		end

		local zoneCenter = zoneX + zoneW * 0.5
		local perfectHalf = zoneW * 0.38 * 0.5
		local isPerfect = perfectHalf >= math.abs(cursorX - zoneCenter)

		local remote = getBidRemote()
		if remote then
			remote:FireServer()
			lastBidTime = now
			if statusLbl then
				statusLbl.Text = isPerfect and "PERFECT!" or "GOOD!"
				statusLbl.TextColor3 = isPerfect and Color3.fromRGB(0, 255, 130) or Color3.fromRGB(100, 255, 100)
			end
		end
	end)
end

buildUI()
startLoop()
